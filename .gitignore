# 构建产物
/build/
/.gradle/
android/local.properties
android/keystore.properties
*.apk
# 例外：编译好的安卓安装包（41KB，别人可直接下载安装，不用自己编译）
!luo-mic.apk

# 忽略所有 jar，但保留两个例外：
#   · android/gradle/wrapper 里的 wrapper（如有）
#   · windows/build/luo-mic.jar —— 预编译好的电脑端程序，让用户不用装 JDK 就能双击运行
*.jar
!android/gradle/wrapper/gradle-wrapper.jar
!windows/build/luo-mic.jar

# IDE
.idea/
*.iml
.vscode/

# Python
__pycache__/
*.pyc

# 临时文件
*.log
