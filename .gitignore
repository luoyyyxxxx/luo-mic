dist/
*.exe
*.zip
*.sha256
# 注意：packaging/ 里是打包脚本本身，要提交
!packaging/

# IDE
.idea/
*.iml
.vscode/

# Python
__pycache__/
*.pyc

# 临时文件
*.log
